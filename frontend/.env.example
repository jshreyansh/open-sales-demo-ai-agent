VITE_API_URL=http://localhost:8787
VITE_VOICE_URL=http://localhost:7860

# Email-ownership verification on the visitor gate.
#
# OFF by default. Turn on only once mail from the configured Postmark sender
# actually lands — see the OTP_ENABLED comment in VisitorGateForm.tsx. The
# whole flow (send, code screen, resend cooldown, rate limits, attempt
# ceiling) stays wired behind this, so enabling is one line, not a rebuild.
VITE_OTP_ENABLED=false
